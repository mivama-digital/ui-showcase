{
  "name": "mivama-ui-showcase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "check:ui-coverage": "node scripts/check-ui-coverage.mjs",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:visual": "PLAYWRIGHT_PRODUCTION=1 playwright test --grep @visual",
    "doctor": "react-doctor -y --no-score --blocking error",
    "verify": "npm run lint && npm run typecheck && npm run check:ui-coverage && npm run doctor && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@mivama/ui": "git+https://github.com/mivama-digital/ui.git#main",
    "lucide-react": "^0.511.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "react-doctor": "^0.9.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
